{
 "schema_version": 1,
 "project_id": "no-perspectives",
 "paths": {
  "chapters": "chapters",
  "chapter_glob": "ch*.md",
  "front_matter": "00-front.md",
  "glossary": "glossary.md",
  "errata": "errata.md",
  "figures": "figures",
  "normalized_source": "ingest/normalized.md",
  "assets": "ingest/assets",
  "asset_link_prefix": "",
  "allowed_asset_roots": [
   "ingest/assets",
   "chapters/figures"
  ]
 },
 "ingest": {
  "heading_rules": [],
  "toc_start_pattern": null,
  "toc_entry_pattern": null,
  "toc_end_pattern": null,
  "drop_source_toc": false
 },
 "chapter_heading_pattern": null,
 "sections": [
  {
   "id": "opening",
   "label": "Starting Question",
   "role": "opening",
   "required": true,
   "boxed": false
  },
  {
   "id": "objectives",
   "label": "Learning Objectives",
   "role": "objectives",
   "required": true,
   "boxed": false
  },
  {
   "id": "takeaways",
   "label": "Key Points",
   "role": "takeaways",
   "required": true,
   "boxed": false
  },
  {
   "id": "assessment",
   "label": "Check Yourself",
   "role": "assessment",
   "required": true,
   "boxed": false
  },
  {
   "id": "answers",
   "label": "Answers",
   "role": "answers",
   "required": true,
   "boxed": false
  },
  {
   "id": "references",
   "label": "References",
   "role": "references",
   "required": true,
   "boxed": false
  },
  {
   "id": "how-to-use",
   "label": "Using This Book",
   "role": "how_to_use",
   "required": false,
   "boxed": false
  }
 ],
 "callouts": [
  {
   "id": "key-idea",
   "label": "Key Idea",
   "syntax": "> **Key Idea:**",
   "required": true,
   "min": 1,
   "max": 2,
   "parts": []
  }
 ],
 "perspectives": {
  "enabled": false,
  "callout_id": null,
  "items": [],
  "balance_tolerance": null
 },
 "learning_objectives": {
  "enabled": true,
  "id_pattern": "^LO\\d+$",
  "min": 2,
  "max": 4,
  "discouraged_verbs": [
   "understand"
  ]
 },
 "assessment": {
  "mcq": {
   "enabled": true,
   "count": 3,
   "option_labels": [
    "A",
    "B",
    "C",
    "D"
   ],
   "option_display_labels": [
    "A",
    "B",
    "C",
    "D"
   ],
   "allow_other_labels": false,
   "key_balance": {
    "min": 0,
    "max": 1
   },
   "max_run": 1,
   "rationale_required": true,
   "answers_section_role": "answers"
  },
  "case_question": {
   "required": true,
   "label": "Case Question."
  }
 },
 "citations": {
  "style": "numeric-bracket",
  "pattern": "\\[(\\d+(?:\\s*[,–-]\\s*\\d+)*)\\]"
 },
 "references": {
  "section_role": "references",
  "entry_pattern": "^(\\d+)\\. (.+)$",
  "identifier_patterns": [
   "10\\.\\d{4,}/\\S+"
  ],
  "no_doi_policy": {
   "allowed_types": [
    "book"
   ],
   "requires_url": false
  },
  "title_match": {
   "mode": "heuristic",
   "words": 6,
   "threshold": 0.6
  },
  "original_title_marker": null,
  "providers": {},
  "type_patterns": {
   "book": "(?i)\\b(royal society|wiley)\\b"
  }
 },
 "locale_overrides": {},
 "glossary": {
  "enabled": true,
  "term_syntax": "bold",
  "excluded_callout_ids": [],
  "minimum_terms": 3
 },
 "readability": {
  "mean_sentence_max": 16,
  "long_sentence_words": 28,
  "long_share_max": 0.05
 },
 "budgets": {
  "tolerance": 0.2,
  "total": {
   "min": 300,
   "max": 800
  },
  "front_matter": 50
 },
 "banned_terms": [],
 "errata": {
  "enabled": true,
  "status_column": "Status",
  "open_values": [
   "open"
  ],
  "closed_values": [
   "fixed"
  ]
 },
 "figures": {
  "caption_pattern": null
 },
 "front_matter": {
  "toc_insert_before_section_id": "how-to-use"
 }
}
