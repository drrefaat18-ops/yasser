{
 "schema_version": 1,
 "project_id": "editorial-book",
 "preset": "ltr-textbook",
 "direction": "ltr",
 "lang_tag": "en-GB",
 "page": {
  "size": "A4",
  "margins": {
   "top": 2.6,
   "bottom": 2.4,
   "left": 3.5,
   "right": 3.5
  },
  "header_distance": 1.3,
  "footer_distance": 1.2
 },
 "fonts": {
  "serif": "Sitka Text",
  "serif_heading": "Sitka Heading",
  "sans": "Segoe UI",
  "complex_script": null,
  "complex_script_heading": null
 },
 "palette": {
  "ink": "1E2A26",
  "primary": "0F5132",
  "accent": "B08534",
  "muted": "5F6B66"
 },
 "layout": {
  "text_width": 14,
  "drop_cap": true
 },
 "alignment": {
  "body": "justify",
  "headings": "left"
 },
 "lists": {
  "indent": 0.6,
  "hanging": 0.6
 },
 "callouts": {
  "opening": {
   "fill": "F3EFE3",
   "label_colour": "8A6420",
   "layout": "box"
  },
  "objectives": {
   "fill": "FFFFFF",
   "label_colour": "0F5132",
   "layout": "box",
   "border": {
    "size_eighths_pt": 6,
    "colour": "C9D1D9"
   }
  },
  "key-idea": {
   "fill": "EAF2EC",
   "label_colour": "0F5132",
   "layout": "box"
  },
  "viewpoints": {
   "fill": "F4F6F5",
   "label_colour": "0F5132",
   "layout": "grid"
  }
 },
 "boxed_section_ids": [
  "opening",
  "objectives"
 ],
 "toc_excluded_section_ids": [],
 "toc": {
  "levels": 2
 },
 "cover": {
  "asset": null,
  "design": {
   "eyebrow": "Academic textbook series",
   "institution": "Faculty of Science",
   "logos": [
    "chapters/figures/logo.png"
   ]
  }
 },
 "title_page": {
  "notices": []
 },
 "labels": {
  "contents": "Contents",
  "update_toc_instruction": "Update the field.",
  "chapter": "Chapter",
  "part": "Part",
  "glossary": "Glossary",
  "figure": "Figure",
  "table": "Table",
  "question_prefix": "Q",
  "objective_prefix": "LO"
 },
 "output": {
  "basename": "editorial-book"
 },
 "build": {
  "backend": "word_com",
  "word_com": {
   "toc_styles": [
    "TOC 1",
    "TOC 2"
   ]
  },
  "pdf": {
   "bookmarks": "headings",
   "embed_fonts": true,
   "engine": "html"
  }
 }
}
