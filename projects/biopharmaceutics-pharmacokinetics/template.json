   "DOI:\\s*(10\\.\\S+?)\\.?\\s*$",
   "doi\\.org/(10\\.\\S+?)\\.?\\s*$"
  ],
  "no_doi_policy": {
   "allowed_types": [
    "book",
    "guidance",
    "pharmacopoeia",
    "regulation"
   ],
   "requires_url": false
  },
  "title_match": {
   "mode": "heuristic",
   "words": 6,
   "threshold": 0.6
  },
  "original_title_marker": null,
  "providers": {},
  "type_patterns": {
   "book": "(?i)\\b(\\d+(st|nd|rd|th) ed\\.?|edition)\\b",
   "guidance": "(?i)\\b(guidance|guideline|guidelines|recommendations)\\b",
   "pharmacopoeia": "(?i)\\b(USP|BP|Ph\\. ?Eur\\.|pharmacopoeia)\\b",
   "regulation": "(?i)\\b(CFR|Regulation|Directive)\\b"
  }
 },
 "locale_overrides": {},
