  ],
  "closed_values": [
   "fixed",
   "removed-with-content"
  ]
 },
 "figures": {
  "caption_pattern": "Figure {chapter}.{n}"
 },
 "front_matter": {
  "toc_insert_before_section_id": "how-to-use"
 },
 "math": {
  "enabled": true
 }
}
