{
 "schema_version": 1,
 "project_id": "ai-in-medicine",
 "paths": {
  "chapters": "rework",
  "chapter_glob": "ch*.md",
  "front_matter": "00-front-matter.md",
  "glossary": "glossary.md",
  "errata": "errata-ledger.md",
  "figures": "rework/figures",
  "normalized_source": "original/AI_in_Medicine- Assistant Prof Dr Shereen Elkholy.md",
  "assets": "images",
  "asset_link_prefix": "images/",
  "allowed_asset_roots": [
   "images",
   "rework/figures"
  ]
 },
 "ingest": {
  "heading_rules": [
   {
    "pattern": "^\\d+\\.\\d+\\.\\d+\\s",
    "level": 3
   },
   {
    "pattern": "^\\d+\\.\\d+\\s",
    "level": 2
   },
   {
    "pattern": "^Chapter Executive Overview",
    "level": 2
   },
   {
    "pattern": "^References.{0,20}$",
    "level": 1
   },
   {
    "pattern": "(?i)^Chapter\\s+\\d+[:\\s]",
    "level": 1
   },
   {
    "pattern": "(?i)^Chapter\\s+\\d+\\s+Review|Review & Self-Assessment",
    "level": 2
   },
   {
    "pattern": "^Self-Assessment Quiz",
    "level": 2
   }
  ],
  "toc_start_pattern": "^Table of Contents$",
  "toc_entry_pattern": "^(Chapter\\s+\\d+:\\s+.*?)\\t+(\\d+)$",
  "toc_end_pattern": "^Chapter 1:[^\\t]*$",
  "drop_source_toc": true
 },
 "chapter_heading_pattern": "^# Chapter (?P<num>\\d+): (?P<title>.+)$",
 "sections": [
  {
   "id": "opening",
   "label": "Opening Case",
   "role": "opening",
   "required": true,
   "boxed": true
  },
  {
   "id": "objectives",
   "label": "Learning Objectives",
   "role": "objectives",
   "required": true,
   "boxed": true
  },
  {
   "id": "takeaways",
   "label": "Key Takeaways",
   "role": "takeaways",
   "required": true,
   "boxed": false
  },
  {
   "id": "assessment",
   "label": "Self-Assessment",
   "role": "assessment",
   "required": true,
   "boxed": false
  },
  {
   "id": "answers",
   "label": "Answers and Rationales",
   "role": "answers",
   "required": true,
   "boxed": false
  },
  {
   "id": "references",
   "label": "References",
   "role": "references",
   "required": true,
   "boxed": false
  },
  {
   "id": "how-to-use",
   "label": "How to Use This Book",
   "role": "how_to_use",
   "required": false,
   "boxed": false
  }
 ],
 "callouts": [
  {
   "id": "background",
   "label": "Medical Background in 60 Seconds",
   "syntax": "> **Medical Background in 60 Seconds:**",
   "required": true,
   "min": 1,
   "max": null,
   "parts": []
  },
  {
   "id": "lenses",
   "label": "Through Four Lenses",
   "syntax": "> **Through Four Lenses**",
   "required": true,
   "min": 1,
   "max": null,
   "parts": [
    "Medicine",
    "Pharmacy",
    "Physical Therapy",
    "Health Sciences"
   ]
  },
  {
   "id": "myth",
   "label": "Myth vs Evidence",
   "syntax": "> **Myth vs Evidence:**",
   "required": true,
   "min": 1,
   "max": null,
   "parts": [
    "Myth",
    "Evidence"
   ]
  },
  {
   "id": "safety",
   "label": "Safety Alert",
   "syntax": "> **Safety Alert:**",
   "required": true,
   "min": 1,
   "max": null,
   "parts": []
  },
  {
   "id": "deeper",
   "label": "Deeper Dive",
   "syntax": "> **Deeper Dive:**",
   "required": false,
   "min": null,
   "max": null,
   "parts": []
  },
  {
   "id": "local",
   "label": "Local Context",
   "syntax": "> **Local Context:**",
   "required": false,
   "min": null,
   "max": null,
   "parts": []
  }
 ],
 "perspectives": {
  "enabled": true,
  "callout_id": "lenses",
  "items": [
   {
    "id": "medicine",
    "label": "Medicine"
   },
   {
    "id": "pharmacy",
    "label": "Pharmacy"
   },
   {
    "id": "physical-therapy",
    "label": "Physical Therapy"
   },
   {
    "id": "health-sciences",
    "label": "Health Sciences"
   }
  ],
  "balance_tolerance": 0.2
 },
 "learning_objectives": {
  "enabled": true,
  "id_pattern": "^LO\\d+$",
  "min": 3,
  "max": 5,
  "discouraged_verbs": [
   "understand"
  ]
 },
 "assessment": {
  "mcq": {
   "enabled": true,
   "count": 10,
   "option_labels": [
    "A",
    "B",
    "C",
    "D"
   ],
   "option_display_labels": [
    "A",
    "B",
    "C",
    "D"
   ],
   "allow_other_labels": false,
   "key_balance": {
    "min": 2,
    "max": 3
   },
   "max_run": 2,
   "rationale_required": true,
   "answers_section_role": "answers"
  },
  "case_question": {
   "required": true,
   "label": "Case Question."
  }
 },
 "citations": {
  "style": "numeric-bracket",
  "pattern": "\\[(\\d+(?:\\s*[,–-]\\s*\\d+)*)\\]"
 },
 "references": {
  "section_role": "references",
  "entry_pattern": "^(\\d+)\\. (.+)$",
  "identifier_patterns": [
   "DOI:\\s*(10\\.\\S+?)\\.?\\s*$",
   "doi\\.org/(10\\.\\S+?)\\.?\\s*$"
  ],
  "no_doi_policy": {
   "allowed_types": [
    "law",
    "regulation",
    "guidance"
   ],
   "requires_url": true
  },
  "title_match": {
   "mode": "heuristic",
   "words": 6,
   "threshold": 0.6
  },
  "original_title_marker": null,
  "providers": {}
 },
 "locale_overrides": {},
 "glossary": {
  "enabled": true,
  "term_syntax": "bold",
  "excluded_callout_ids": [
   "lenses"
  ],
  "minimum_terms": 120
 },
 "readability": {
  "mean_sentence_max": 16,
  "long_sentence_words": 28,
  "long_share_max": 0.05
 },
 "budgets": {
  "tolerance": 0.15,
  "total": {
   "min": 17000,
   "max": 21000
  },
  "front_matter": 500
 },
 "banned_terms": [
  {
   "pattern": "(?i)master[-–]slave",
   "replacement": "leader–follower"
  }
 ],
 "errata": {
  "enabled": true,
  "status_column": "Status",
  "open_values": [
   "open"
  ],
  "closed_values": [
   "fixed",
   "removed-with-content"
  ]
 },
 "figures": {
  "caption_pattern": "Figure {chapter}.{n}"
 },
 "front_matter": {
  "toc_insert_before_section_id": "how-to-use"
 }
}
