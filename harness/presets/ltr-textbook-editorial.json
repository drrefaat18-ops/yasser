{
 "schema_version": 1,
 "id": "ltr-textbook-editorial",
 "direction": "ltr",
 "fonts": {
  "serif": "Source Serif 4",
  "serif_heading": "Playfair Display",
  "sans": "Alexandria",
  "complex_script": null,
  "complex_script_heading": null
 },
 "page": {
  "size": "A4",
  "width_cm": 21,
  "height_cm": 29.7,
  "margins": {
   "top": 2.6,
   "bottom": 2.4,
   "left": 3.5,
   "right": 3.5
  },
  "header_distance": 1.3,
  "footer_distance": 1.2
 },
 "palette": {
  "ink": "1D2A38",
  "primary": "12324F",
  "accent": "9A6B00",
  "muted": "5A6470"
 },
 "layout": {
  "text_width": 14
 },
 "design": {
  "chapter_opener": "page",
  "toc_style": "chapters",
  "title_page": "centered",
  "running_style": "caps",
  "page_number": "right"
 },
 "title_page_layout": [
  {
   "field": "title",
   "font": "serif_heading",
   "size_pt": 30,
   "bold": true,
   "colour": "primary",
   "space_before_pt": 150
  },
  {
   "field": "subtitle",
   "font": "serif_heading",
   "size_pt": 16,
   "italic": true,
   "colour": "muted",
   "rule_below": {
    "size_eighths_pt": 18,
    "colour": "F0B429",
    "space_pt": 14
   }
  },
  {
   "field": "credits",
   "font": "serif",
   "size_pt": 13,
   "bold": true,
   "space_before_pt": 36
  },
  {
   "field": "audience_line",
   "font": "sans",
   "size_pt": 9.5,
   "colour": "muted"
  },
  {
   "field": "notices",
   "font": "sans",
   "size_pt": 8.5,
   "colour": "muted",
   "space_before_pt": 430,
   "space_after_pt": 5,
   "new_page": true
  }
 ],
 "required_font_files": [
  "SourceSerif4-Regular.ttf",
  "SourceSerif4-Bold.ttf",
  "SourceSerif4-It.ttf",
  "SourceSerif4-BoldIt.ttf",
  "PlayfairDisplay-Regular.ttf",
  "PlayfairDisplay-Bold.ttf",
  "PlayfairDisplay-Italic.ttf",
  "PlayfairDisplay-BoldItalic.ttf",
  "Alexandria-Regular.ttf",
  "Alexandria-Bold.ttf"
 ]
}
