{
 "schema_version": 1,
 "id": "ltr-textbook",
 "direction": "ltr",
 "fonts": {
  "serif": "Sitka Text",
  "serif_heading": "Sitka Heading",
  "sans": "Segoe UI",
  "complex_script": null,
  "complex_script_heading": null
 },
 "page": {
  "size": "A4",
  "width_cm": 21,
  "height_cm": 29.7,
  "margins": {
   "top": 2.6,
   "bottom": 2.4,
   "left": 3.5,
   "right": 3.5
  },
  "header_distance": 1.3,
  "footer_distance": 1.2
 },
 "palette": {
  "ink": "1D2A38",
  "primary": "12324F",
  "accent": "9A6B00",
  "muted": "5A6470"
 },
 "layout": {
  "text_width": 14
 },
 "title_page_layout": [
  {
   "field": "title",
   "font": "serif_heading",
   "size_pt": 30,
   "bold": true,
   "colour": "primary",
   "space_before_pt": 150
  },
  {
   "field": "subtitle",
   "font": "serif_heading",
   "size_pt": 16,
   "italic": true,
   "colour": "muted",
   "rule_below": {
    "size_eighths_pt": 18,
    "colour": "F0B429",
    "space_pt": 14
   }
  },
  {
   "field": "credits",
   "font": "serif",
   "size_pt": 13,
   "bold": true,
   "space_before_pt": 36
  },
  {
   "field": "audience_line",
   "font": "sans",
   "size_pt": 9.5,
   "colour": "muted"
  },
  {
   "field": "notices",
   "font": "sans",
   "size_pt": 8.5,
   "colour": "muted",
   "space_before_pt": 430,
   "space_after_pt": 5,
   "new_page": true
  }
 ],
 "required_font_files": [
  "Sitka.ttc",
  "segoeui.ttf"
 ]
}
