{
 "type": "object",
 "required": [
  "schema_version",
  "tag",
  "script",
  "direction",
  "normalisation",
  "tokenizer",
  "sentence_terminators",
  "discouraged_objective_verbs",
  "banned_terms",
  "readability",
  "chapter_heading_pattern",
  "figure_caption_pattern",
  "default_labels",
  "digits"
 ],
 "properties": {
  "schema_version": {
   "const": 1
  },
  "tag": {
   "type": "string",
   "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
  },
  "script": {
   "type": "string"
  },
  "direction": {
   "enum": [
    "ltr",
    "rtl"
   ]
  },
  "normalisation": {
   "type": "object",
   "required": [
    "compare",
    "count"
   ],
   "properties": {
    "compare": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "count": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   },
   "additionalProperties": false
  },
  "tokenizer": {
   "type": "object",
   "required": [
    "kind",
    "pattern"
   ],
   "properties": {
    "kind": {
     "type": "string",
     "pattern": "\\S"
    },
    "pattern": {
     "type": "string",
     "pattern": "\\S"
    }
   },
   "additionalProperties": false
  },
  "sentence_terminators": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "minItems": 1
  },
  "discouraged_objective_verbs": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "banned_terms": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "pattern",
     "replacement"
    ],
    "properties": {
     "pattern": {
      "type": "string",
      "pattern": "\\S"
     },
     "replacement": {
      "type": "string"
     }
    },
    "additionalProperties": false
   }
  },
  "readability": {
   "type": "object",
   "required": [
    "mean_sentence_max",
    "long_sentence_words",
    "long_share_max"
   ],
   "properties": {
    "mean_sentence_max": {
     "type": "number"
    },
    "long_sentence_words": {
     "type": "integer"
    },
    "long_share_max": {
     "type": "number"
    }
   },
   "additionalProperties": false
  },
  "chapter_heading_pattern": {
   "type": "string",
   "pattern": "\\S"
  },
  "figure_caption_pattern": {
   "type": "string",
   "pattern": "\\S"
  },
  "default_labels": {
   "type": "object",
   "additionalProperties": {
    "type": "string"
   }
  },
  "digits": {
   "type": "object",
   "required": [
    "accepted",
    "output"
   ],
   "properties": {
    "accepted": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "minItems": 1
    },
    "output": {
     "type": "string"
    }
   },
   "additionalProperties": false
  }
 },
 "additionalProperties": false
}
