{
 "type": "object",
 "required": [
  "schema_version",
  "units"
 ],
 "properties": {
  "schema_version": {
   "const": 1
  },
  "units": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "heading",
     "level",
     "line_start",
     "line_end",
     "sha256"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^src-ch\\d{2}(-s\\d{2})?$"
     },
     "heading": {
      "type": "string",
      "pattern": "\\S"
     },
     "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6
     },
     "line_start": {
      "type": "integer",
      "minimum": 1
     },
     "line_end": {
      "type": "integer",
      "minimum": 1
     },
     "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
     }
    },
    "additionalProperties": false
   }
  }
 },
 "additionalProperties": false
}
